  <!-- THEME TOGGLE SCRIPT WITH LOCALSTORAGE PERSISTENCE -->
  <script>
    (function () {
      const themeToggleBtn = document.getElementById('themeToggleBtn');
      const headerThemeBtn = document.getElementById('headerThemeBtn');
      const themeIconContainer = document.getElementById('themeIconContainer');
      const headerThemeIcon = document.getElementById('headerThemeIcon');
      const themeLabel = document.getElementById('themeLabel');
      const htmlElement = document.documentElement;

      // Check saved theme or default to dark mode
      const savedTheme = localStorage.getItem('alfred_portfolio_theme') || 'dark';

      function applyTheme(theme) {
        if (theme === 'light') {
          htmlElement.classList.remove('dark');
          htmlElement.classList.add('light');
          themeIconContainer.innerHTML = '<i class="fa-solid fa-sun text-amber-500"></i>';
          headerThemeIcon.className = 'fa-solid fa-sun text-amber-500 text-sm';
          themeLabel.textContent = 'Light';
        } else {
          htmlElement.classList.remove('light');
          htmlElement.classList.add('dark');
          themeIconContainer.innerHTML = '<i class="fa-solid fa-moon text-amber-400"></i>';
          headerThemeIcon.className = 'fa-solid fa-moon text-amber-400 text-sm';
          themeLabel.textContent = 'Dark';
        }
        localStorage.setItem('alfred_portfolio_theme', theme);
      }

      // Initialize saved theme
      applyTheme(savedTheme);

      // Toggle handler
      function toggleTheme() {
        const currentTheme = htmlElement.classList.contains('light') ? 'light' : 'dark';
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        applyTheme(newTheme);
      }

      themeToggleBtn.addEventListener('click', toggleTheme);
      headerThemeBtn.addEventListener('click', toggleTheme);
    })();

