  <style>
    /* CSS Variables for Dynamic Dark & Light Mode Theme Switcher */
    :root {
      --bg-color: #0d0f12;
      --card-bg: #161920;
      --card-inner-bg: #0f1117;
      --border-color: rgba(255, 255, 255, 0.08);
      --border-hover: rgba(0, 230, 118, 0.35);
      --text-main: #f0f3f8;
      --text-muted: #9aa0a6;
      --text-sub: #cbd5e1;
      --accent-color: #00e676;
      --accent-bg-alpha: rgba(0, 230, 118, 0.12);
      --accent-border-alpha: rgba(0, 230, 118, 0.25);
      --card-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
      --badge-bg: rgba(255, 255, 255, 0.05);
    }

    html.light {
      --bg-color: #f8fafc;
      --card-bg: #ffffff;
      --card-inner-bg: #f1f5f9;
      --border-color: #e2e8f0;
      --border-hover: #10b981;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --text-sub: #334155;
      --accent-color: #059669;
      --accent-bg-alpha: rgba(5, 150, 105, 0.12);
      --accent-border-alpha: rgba(5, 150, 105, 0.3);
      --card-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.08);
      --badge-bg: #f1f5f9;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      font-family: 'Inter', sans-serif;
      overflow-x: hidden;
      transition: background-color 0.3s ease, color 0.3s ease;
    }

    .theme-card {
      background-color: var(--card-bg);
      border: 1px solid var(--border-color);
      box-shadow: var(--card-shadow);
      transition: background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .theme-card:hover {
      border-color: var(--border-hover);
    }

    .theme-card-inner {
      background-color: var(--card-inner-bg);
      border: 1px solid var(--border-color);
      transition: background-color 0.3s ease, border-color 0.3s ease;
    }

    .theme-text-main {
      color: var(--text-main);
      transition: color 0.3s ease;
    }

    .theme-text-muted {
      color: var(--text-muted);
      transition: color 0.3s ease;
    }

    .theme-text-sub {
      color: var(--text-sub);
      transition: color 0.3s ease;
    }

    .theme-accent-text {
      color: var(--accent-color);
      transition: color 0.3s ease;
    }

    .theme-accent-bg {
      background-color: var(--accent-bg-alpha);
      border: 1px solid var(--accent-border-alpha);
      color: var(--accent-color);
      transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
    }

    .theme-badge {
      background-color: var(--badge-bg);
      border: 1px solid var(--border-color);
      color: var(--text-sub);
      transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
    }

    /* Ambient background blur elements */
    .glow-blur-1 {
      background: var(--accent-color);
      opacity: 0.12;
      transition: opacity 0.3s ease, background-color 0.3s ease;
    }

    html.light .glow-blur-1 {
      opacity: 0.06;
    }
  </style>
</head>
